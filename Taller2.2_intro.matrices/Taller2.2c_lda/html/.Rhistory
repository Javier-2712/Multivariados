sum <- as.matrix(medias[medias$Sexo == "M", -1] + medias[medias$Sexo == "F", -1])  # Vector fila (1x4)
sum <- t(sum)  # Convertir a vector columna (4x1)
# Agrupación por sexo y cálculo de medias
medias <- datos2 %>%
group_by(Sexo) %>%
summarise(across(1:4, mean))  # Calcular medias para las columnas 2 a 5
# Vector de medias por cada sexo
medias <- data.frame(Sexo = medias$Sexo, round(medias[2:5], 2))
medias
