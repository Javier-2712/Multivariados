Sexo_original = datos2$Sexo)  # Añadir columna con el sexo original
# librerías
library(MASS)
library(lattice)
library(tidyverse)
library(kableExtra)
library(gridExtra)    # Para figuras estadísticas (varios factores)
library(grid)         # Para figuras estadísticas (varios factores)
# Cargar la base de datos
datos2 <- read.csv2("datos1.csv", row.names = 1)
datos2 <- na.omit(datos2)  # Eliminar al estudiante 13
colnames(datos2) <- c("Sexo", "LTot", "Cint", "LEsp", "LBra")  # Rótulos de la base de datos
head(datos2)  # Base de datos abreviada
# Agrupación por sexo y cálculo de medias
medias <- datos2 %>%
group_by(Sexo) %>%
summarise(across(1:4, mean))  # Calcular medias para las columnas 2 a 5
# Vector de medias por cada sexo
medias <- data.frame(Sexo = medias$Sexo, round(medias[2:5], 2))
medias
# Vector de diferencias de medias
dif <- as.matrix(medias[medias$Sexo == "M", -1] - medias[medias$Sexo == "F", -1])  # Vector fila (1x4)
dif <- t(dif)  # Convertir a vector columna (4x1)
# Vector de suma de medias
sum <- as.matrix(medias[medias$Sexo == "M", -1] + medias[medias$Sexo == "F", -1])  # Vector fila (1x4)
sum <- t(sum)  # Convertir a vector columna (4x1)
# Cálculo de varianzas-covarianzas para hombres y mujeres
cov.h <- var(datos2 %>%
filter(Sexo == "M") %>%
select(2:5))
cov.m <- cov(datos2 %>%
filter(Sexo == "F") %>%
select(2:5))
# Tamaño de muestra
n_h <- sum(datos2$Sexo == "M")  # tamaño de muestra de hombres
n_m <- sum(datos2$Sexo == "F")  # tamaño de muestra de hombres
# # Covarianza generalizada
cov.g <- (n_h * cov.h + n_m * cov.m) / (n_h + n_m)
# Inversión de la matriz de covarianza generalizada
cov.g.i <- solve(cov.g)
round(cov.g.i,3)
# Matriz de variables para los hombres
hombres = datos2[datos2$Sexo == "M",]
head(hombres)
# Opción en tidyverse
hombres = datos2 %>%
filter(Sexo == "M")
head(hombres)
# filtrar mujeres
mujeres = datos2[datos2$Sexo == "F",]
head(mujeres)
# Vector de medias de hombres
promedio.h = colMeans(hombres[,c(2:5)])
promedio.h
# Vector de medias de mujeres
promedio.m = colMeans(mujeres[,c(2:5)])
promedio.m
# Suma de medias (M1 + M2)
sum = promedio.h + promedio.m
sum
# Varianzas - Covarianzas de hombres
cov.h = var(hombres[,2:5])
round(cov.h,2)
# Varianzas - Covarianzas de mujeres
cov.m = var(mujeres[,2:5])
round(cov.m,2)
# Varianzas - covarianzas generalizadas (cov.g)
# cov.g = (n.h * cov.h + n.m * cov.m)/N
summary(datos2$Sexo)
# Varianzas - covarianzas generalizadas (cov.g)
# cov.g = (n.h * cov.h + n.m * cov.m)/N
datos2$Sexo = as.factor(datos2$Sexo)
summary(datos2$Sexo)
# Varianzas - covarianzas generalizadas (cov.g)
# cov.g = (n.h * cov.h + n.m * cov.m)/N
cov.g = (10*cov.h + 14*cov.m)/24
round(cov.g,2)
# varianzas - covarianzas generalizadas e invertidas (S^-1)
cov.g.i = solve(cov.g)
round(cov.g.i,2)
# Convertir datos2 a formato matricial como datos3
datos3 = as.matrix (datos2[,2:5])
head(datos3)
# Vector de diferencias de medias
dif <- as.matrix(medias[medias$Sexo == "M", -1] - medias[medias$Sexo == "F", -1])  # Vector fila (1x4)
dif <- t(dif)  # Convertir a vector columna (4x1)
# Vector de suma de medias
sum <- as.matrix(medias[medias$Sexo == "M", -1] + medias[medias$Sexo == "F", -1])  # Vector fila (1x4)
sum <- t(sum)  # Convertir a vector columna (4x1)
# Función discriminante para todos los estudiantes
